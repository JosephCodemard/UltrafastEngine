<Project Sdk="Microsoft.NET.Sdk">
  <!-- Command-line front end: `ultrafast run system.ufs run.json -o out`. Cross-platform (Windows, macOS, Linux). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ultrafast</AssemblyName>
    <RootNamespace>UltrafastEngine.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
      <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\ultrafast.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UltrafastEngine.Core\UltrafastEngine.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the agent pack: one source, the skills of the Python wheel (python/src/ultrafast/agents/pack); `ultrafast agent install` writes them -->
    <EmbeddedResource Include="..\..\python\src\ultrafast\agents\pack\**\SKILL.md" LogicalName="agentpack/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\python\src\ultrafast\agents\pack\AGENTS.md" LogicalName="agentpack/AGENTS.md" />
    <EmbeddedResource Include="..\..\python\src\ultrafast\agents\pack\llms.txt" LogicalName="agentpack/llms.txt" />
  </ItemGroup>
  <Import Project="$(RepoRoot)build/CopyPlugins.targets" />
</Project>
