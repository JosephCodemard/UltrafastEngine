{
  // Example 08: second-harmonic generation of a 1 ps Yb pulse in LBO -- the pump line for example 09.
  // The main beam enters at 1030 nm and leaves as the 515 nm second harmonic ("output": "sh"); the unconverted
  // fundamental is kept as a by-product (results: "shg#fundamental").
  "$schema": "../../../schemas/ufs.schema.json",
  "format": "ultrafast-system",
  "version": 2,
  "name": "shg-lbo",
  "description": "Yb 1030 nm, 1 ps, 400 uJ -> LBO type-I (XY, theta = 90 deg) SHG -> 515 nm",
  "elements": [
    { "id": "shg", "type": "crystal",
      "crystal": "LBO",
      "lengthM": 2.0e-3,
      // type-I ooe in the XY plane; "cut": "auto" phase-matches at the nominal (input) wavelength -> phi ~ 13.8 deg
      "interaction": { "process": "shg", "type": "I" },
      "cut": "auto",
      // collimated 1.3 mm (1/e^2) beam: ~10 GW/cm^2 peak -- typical for ps SHG in LBO
      "beam": { "kind": "gaussian", "w0M": 1.3e-3 },
      "output": "sh",
      "record": ["fundamental"] },
    // 5 cm of air to the next stage (dispersion and n2 of air are tiny but included)
    { "id": "air", "type": "gap", "lengthM": 0.05 }
  ]
}
