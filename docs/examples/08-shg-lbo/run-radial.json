{
  // Same run with a radial (Hankel) transverse model inside the crystal: the conversion is computed point by point
  // across the beam, so the centre converts more than the wings and the SH beam profile and M^2 come out.
  "$schema": "../../../schemas/run.schema.json",
  "format": "ultrafast-run", "version": 2,
  "name": "shg-lbo-radial",
  "pulse": { "shape": "gaussian", "centerWavelengthM": 1.03e-6, "durationFwhmS": 1e-12,
             "energyJ": 400e-6, "repRateHz": 1e3, "polarization": "x" },
  "physics": { "selfSteepening": true, "transverse": { "model": "radial", "points": 48 } },
  "probes": "all",
  "instruments": [
    { "kind": "conversion", "at": "shg" },
    { "kind": "beamProfile", "at": "shg" },
    { "kind": "pulseSummary" }
  ]
}
