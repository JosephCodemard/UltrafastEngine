{
  "$schema": "../../../schemas/run.schema.json",
  "format": "ultrafast-run", "version": 2,
  "name": "shg-lbo",
  "pulse": { "shape": "gaussian", "centerWavelengthM": 1.03e-6, "durationFwhmS": 1e-12,
             "energyJ": 400e-6, "repRateHz": 1e3, "polarization": "x" },
  "physics": { "selfSteepening": true },
  "probes": "all",
  "instruments": [
    { "kind": "conversion", "at": "shg" },
    { "kind": "phaseMatchingCurve", "at": "shg", "scan": "angle", "rangeDeg": 1.0, "points": 201 },
    { "kind": "phaseMatchingCurve", "name": "acceptance_wavelength", "at": "shg", "scan": "wavelength", "rangeM": 20e-9 },
    { "kind": "spectrometer" },
    { "kind": "pulseSummary" }
  ]
}
