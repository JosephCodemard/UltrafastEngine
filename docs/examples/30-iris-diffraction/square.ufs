{
  // Example 30: a square flat-top beam (separable super-Gaussian of order 10, half-width 1.5 mm) through a 2 x 2 mm square aperture.
  // Grid shared by every element, so the profile is copied, not interpolated, from one element to the next.
  "$schema": "../../../schemas/ufs.schema.json",
  "format": "ultrafast-system",
  "version": 2,
  "name": "square",
  "elements": [
    { "id": "source", "type": "gap", "lengthM": 0, "material": "Vacuum", "transverse": { "model": "cartesian", "nx": 512, "ny": 512, "halfWidthM": 12e-3, "absorbingBoundary": true, "spectralSamples": 4,
        "initialProfile": { "kind": "flatTop", "geometry": "square", "radiusM": 1.5e-3 } } },
    { "id": "iris", "type": "aperture", "halfWidthXM": 1e-3, "halfWidthYM": 1e-3 },
    { "id": "n3", "type": "gap", "lengthM": 0.323625, "material": "Vacuum", "transverse": { "model": "cartesian", "nx": 512, "ny": 512, "halfWidthM": 12e-3, "absorbingBoundary": true, "spectralSamples": 4 } },   // N = 3: z = 0.3236 m
    { "id": "n2", "type": "gap", "lengthM": 0.161812, "material": "Vacuum", "transverse": { "model": "cartesian", "nx": 512, "ny": 512, "halfWidthM": 12e-3, "absorbingBoundary": true, "spectralSamples": 4 } },   // N = 2 (dark centre for a uniform beam): z = 0.4854 m
    { "id": "n1", "type": "gap", "lengthM": 0.485437, "material": "Vacuum", "transverse": { "model": "cartesian", "nx": 512, "ny": 512, "halfWidthM": 12e-3, "absorbingBoundary": true, "spectralSamples": 4 } },   // N = 1: z = 0.9709 m
    { "id": "far", "type": "gap", "lengthM": 4.02913, "material": "Vacuum", "transverse": { "model": "cartesian", "nx": 512, "ny": 512, "halfWidthM": 12e-3, "absorbingBoundary": true, "spectralSamples": 4 } }   // far zone, N = 0.19: z = 5.0000 m
  ]
}
