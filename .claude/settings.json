{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1",
    "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet tests/UltrafastEngine.Tests/bin/*)",
      "Bash(dotnet src/UltrafastEngine.Cli/bin/*)",
      "Bash(dotnet --info)",
      "Bash(mono tests/UltrafastEngine.Tests/bin/*)",
      "Bash(python3 python/tools/*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m mkdocs build:*)",
      "Bash(mypy:*)",
      "Bash(./build.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Edit(plugins/zemax/src/UltrafastEngine.Zemax/lib/**)",
      "Write(plugins/zemax/src/UltrafastEngine.Zemax/lib/**)",
      "Read(**/bin/**)",
      "Read(**/obj/**)",
      "Read(artifacts/**)",
      "Read(dist/**)",
      "Read(site/**)",
      "Read(python/third_party/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_paths.py\"", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/py.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/after_edit.py\"", "timeout": 10 }
        ]
      }
    ]
  }
}
