<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The fitting plugin: compares instruments with recorded data ("measured") and calibrates parameters ("fit").
    Stage 2 of the roadmap rebuilds it around "transform" elements. Laid out as an installable plugin folder in
    artifacts/plugins/fitting (see build/Plugin.targets).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <RootNamespace>UltrafastEngine.Plugins.Fitting</RootNamespace>
    <AssemblyName>UltrafastEngine.Plugins.Fitting</AssemblyName>
    <PluginId>fitting</PluginId>
    <PluginFolder>$(MSBuildThisFileDirectory)../</PluginFolder>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/UltrafastEngine.Core/UltrafastEngine.Core.csproj" Private="false" />
  </ItemGroup>
  <Import Project="$(RepoRoot)build/Plugin.targets" />
</Project>
