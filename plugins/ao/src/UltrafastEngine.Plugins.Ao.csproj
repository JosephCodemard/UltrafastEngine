<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The adaptive-optics plugin: deformableMirror, slm, spectralShaper and aopdf elements. Laid out as an installable
    plugin folder in artifacts/plugins/ao (see build/Plugin.targets).
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <RootNamespace>UltrafastEngine.Plugins.Ao</RootNamespace>
    <AssemblyName>UltrafastEngine.Plugins.Ao</AssemblyName>
    <PluginId>ao</PluginId>
    <PluginFolder>$(MSBuildThisFileDirectory)../</PluginFolder>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/UltrafastEngine.Core/UltrafastEngine.Core.csproj" Private="false" />
  </ItemGroup>
  <Import Project="$(RepoRoot)build/Plugin.targets" />
</Project>
