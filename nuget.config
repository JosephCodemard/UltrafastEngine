<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The engine has no NuGet dependencies; nuget.org is needed only for NativeAOT publishing
       (runtime packs and ILCompiler are downloaded on the first AOT publish: build_engine.py with the aot option, or dotnet publish with a RID). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
